POSTGRES_PASSWORD=change-postgres-password
REDIS_PASSWORD=change-redis-password
JWT_SECRET=change-jwt-secret
INTERNAL_API_TOKEN=change-internal-api-token
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-minio-secret
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GATEWAY_RATE_LIMIT_PERMITS_PER_SECOND=200
GATEWAY_RATE_LIMIT_CACHE_EXPIRE_MINUTES=30
GATEWAY_RATE_LIMIT_CACHE_MAX_SIZE=100000

# ===== MCP Server 连接串（opencode mcp.json 使用） =====
DATABASE_URL=postgresql://postgres:change-postgres-password@localhost:5432/edu_platform
REDIS_URL=redis://:change-redis-password@localhost:6379
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-personal-github-token

